<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Codebelt.Coverlet.MTP" Version="10.1.0" />
    <PackageVersion Include="Codebelt.Extensions.Swashbuckle.AspNetCore" Version="10.3.0" />
    <PackageVersion Include="Codebelt.Extensions.Xunit.App" Version="12.0.2" />
    <PackageVersion Include="Cuemon.Core" Version="10.8.1" />
    <PackageVersion Include="Cuemon.Extensions.Hosting" Version="10.8.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.1" />
    <PackageVersion Include="MinVer" Version="8.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.v3.runner.console" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9'))">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.21" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.21" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.StartsWith('net10'))">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>
</Project>
